    {
      "y": 1075,
      "x": 720,
      "w": 688,
      "txt": "Dipsco, the trendy hummus sensation founded in 2022, prides itself on crafting homemade goodness.",
      "fs": "24px"
    },
    {
      "y": 1171,
      "x": 720,
      "w": 688,
      "txt": "Made from 100% natural ingredients and without any artificial preservatives, Dipsco's hummus offers a pure and flavorful indulgence that stands out in the crowded market.",
      "fs": "24px"
    },
    {
      "y": 1299,
      "x": 720,
      "w": 688,
      "txt": "This branding style draws heavy inspiration from vintage retro illustrations, perfectly complementing the brand's trendy, youthful, and approachable vibe.",
      "fs": "24px"
    }
